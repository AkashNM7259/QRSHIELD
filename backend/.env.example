# QRShield Backend Environment Configuration

# Flask Core
SECRET_KEY=qrshield-development-secret-key-replace-in-production
DEBUG=True
PORT=5000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///qrshield.db

# File Upload Limits
MAX_CONTENT_LENGTH=10485760

# Threat Intelligence (Google Safe Browsing v4 API)
# Optional: If omitted, the engine uses internal heuristic threat signatures and reports external status as UNAVAILABLE
SAFE_BROWSING_API_KEY=
THREAT_API_TIMEOUT=3

# Risk Engine Weights
WEIGHT_MALICIOUS_DOMAIN=60
WEIGHT_DESTINATION_MISMATCH=50
WEIGHT_PAYMENT_MISMATCH=35
WEIGHT_SUSPICIOUS_URL_STRUCTURE=20
WEIGHT_UNVERIFIED_SHORTENER=10
WEIGHT_RAW_IP_HOST=35
WEIGHT_PUNYCODE_HOMOGRAPH=30

# CORS
CORS_ORIGINS=*

